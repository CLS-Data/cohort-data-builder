# The proof of concept is its own git repository (macknix/cohort-data-builder),
# kept locally as a reference only.
PoC/

# macOS
.DS_Store

# Claude Code: per-machine settings and state; the Spec Kit skills are shared.
.claude/settings.local.json
.claude/.cc-writes/
.claude/skills/speckit-taskstoissues/

# R session history
**/.Rhistory

# Tooling
.venv/
node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/
test-results/

# Topic tagging working files (docs/data-format.md, "Adding topics")
/variables.jsonl
/tags/

# Supplied metadata: never committed (no study data in the repository)
/CLS_studies_metadata.csv

# Ad hoc processing: the data folders are kept, their contents never committed
/adhoc/data/*/*
!/adhoc/data/*/.gitkeep
